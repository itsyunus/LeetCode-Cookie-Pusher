{
  "manifest_version": 3,
  "name": "LeetCode Cookie Pusher",
  "version": "1.0.1",
  "description": "Extract LeetCode session cookies and push them to GitHub Secrets. One click.",
  "permissions": [
    "cookies",
    "storage"
  ],
  "host_permissions": [
    "https://leetcode.com/*",
    "https://*.leetcode.com/*",
    "https://api.github.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
